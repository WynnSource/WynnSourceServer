# Copy to .env next to docker-compose.yaml and fill in the required values.
# .env is git-ignored. Every variable is documented in the root README.

# --- Required -------------------------------------------------------------
POSTGRES_PASSWORD=change-me
WCS_ADMIN_TOKEN=change-me

# --- Image and listener ---------------------------------------------------
# Release tag (e.g. 0.1.8) or latest. Pin a version in production.
WCS_VERSION=latest
# Host address and port the server is published on. Keep 127.0.0.1 when a
# reverse proxy on the same host terminates TLS.
WCS_BIND=127.0.0.1
WCS_PORT=8000

# --- Database --------------------------------------------------------------
POSTGRES_DB=wcs_db
POSTGRES_USER=wynnsource

# --- Server ---------------------------------------------------------------
LEVEL=INFO
LOG_JSON=false
MAX_IP_RECORDS=10
# Comma-separated mod versions allowed to submit while in beta.
BETA_ALLOWED_VERSIONS=

# --- Optional: error reporting (Sentry) -----------------------------------
# WCS_SENTRY_DSN=
# WCS_SENTRY_ENVIRONMENT=production
# WCS_SENTRY_PROFILE_SESSION_SAMPLE_RATE=0

# --- Optional: OpenTelemetry traces and metrics (OTLP/HTTP) -----------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
